        { "challenge": "NOSE LT", "response": "T.O",
          "checks": [ { "control": "ext_lt.nose", "expect": ["T.O"] } ] },
        { "challenge": "RWY TURN OFF", "response": "ON",
          "checks": [ { "control": "ext_lt.rwy_turn_off", "expect": ["ON"] } ] },
        { "challenge": "TCAS", "response": "TA/RA",
          "checks": [ { "control": "tcas.mode", "expect": ["TA/RA"] } ] },
        { "challenge": "PACKS", "response": "AS RQRD", "panels": ["air_cond"] }
