        { "challenge": "ENGINES", "response": "OFF",
          "checks": [ { "control": "eng.master1", "expect": ["OFF"] }, { "control": "eng.master2", "expect": ["OFF"] } ] },
        { "challenge": "WINGS LIGHT", "response": "OFF",
